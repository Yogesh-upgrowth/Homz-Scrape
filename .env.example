# ============================================================================
# Homz Realtor — Real Estate Intelligence Platform
# Copy to .env and fill in. NEVER commit the filled-in .env.
# ============================================================================

# ---- runtime ---------------------------------------------------------------
HOMZ_ENV=dev                       # dev | staging | prod
HOMZ_LOG_LEVEL=INFO
HOMZ_LOG_JSON=false                # true in prod (structured logs for shipping)

# ---- database (MongoDB Atlas) ----------------------------------------------
# Atlas: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Local (docker compose --profile local up -d mongo):
#   mongodb://localhost:27017/?directConnection=true
HOMZ_MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
HOMZ_MONGODB_DATABASE=homz
HOMZ_MONGODB_MAX_POOL_SIZE=20
HOMZ_MONGODB_TIMEOUT_MS=20000

# Search backend: auto probes the cluster; force with atlas | text.
# Atlas Search gives fuzzy/typo tolerance; $text does not.
HOMZ_SEARCH_BACKEND=auto
HOMZ_ATLAS_SEARCH_INDEX=properties_search
HOMZ_ATLAS_REDDIT_INDEX=reddit_search

# ---- scraping behaviour ----------------------------------------------------
# Compliance gates. Leave these ON unless you hold written permission from the
# site owner. See COMPLIANCE.md.
HOMZ_RESPECT_ROBOTS=true
HOMZ_ABORT_ON_BLOCK=true           # stop a job when captcha/403 wall is detected
HOMZ_MAX_CONCURRENCY=4             # global in-flight requests
HOMZ_PER_HOST_RPS=0.5              # requests/sec per host (0.5 = 1 req / 2s)
HOMZ_PER_HOST_BURST=2
HOMZ_REQUEST_TIMEOUT=30
HOMZ_MAX_RETRIES=4
HOMZ_RAW_HTML_DIR=./data/raw
HOMZ_STORE_RAW_HTML=true
HOMZ_RAW_HTML_RETENTION_DAYS=14

# ---- proxies (optional) ----------------------------------------------------
# Comma-separated. Supports http://user:pass@host:port and socks5://
HOMZ_PROXIES=
HOMZ_PROXY_STRATEGY=round_robin    # round_robin | random | sticky_per_host
HOMZ_PROXY_COOLDOWN_SECONDS=300    # bench a proxy this long after a hard block

# ---- playwright ------------------------------------------------------------
HOMZ_PLAYWRIGHT_HEADLESS=true
HOMZ_PLAYWRIGHT_BROWSER=chromium
HOMZ_PLAYWRIGHT_NAV_TIMEOUT=45000
HOMZ_PLAYWRIGHT_MAX_CONTEXTS=2

# ---- reddit (official API — https://www.reddit.com/prefs/apps) -------------
# Create a "script" app. Read-only access is enough.
HOMZ_REDDIT_CLIENT_ID=
HOMZ_REDDIT_CLIENT_SECRET=
# Reddit requires a descriptive, contactable UA. Format is enforced by Reddit.
HOMZ_REDDIT_USER_AGENT=python:com.homzrealtor.intel:v1.0.0 (by /u/your_reddit_user)
HOMZ_REDDIT_SUBREDDITS=gurgaon,noida,delhi,india_real_estate,realestateindia
HOMZ_REDDIT_COMMENT_LIMIT=50

# ---- AI enrichment (Anthropic) --------------------------------------------
# Leave ANTHROPIC_API_KEY unset to use an `ant auth login` profile instead.
ANTHROPIC_API_KEY=
HOMZ_LLM_MODEL=claude-opus-4-8
HOMZ_LLM_MAX_TOKENS=4096
HOMZ_LLM_EFFORT=medium             # low | medium | high | xhigh | max
HOMZ_LLM_ENABLED=true
HOMZ_LLM_USE_BATCH=true            # Message Batches API: 50% cheaper for bulk
HOMZ_LLM_BATCH_SIZE=500
HOMZ_LLM_CACHE_SYSTEM_PROMPT=true

# ---- on-demand fill (search miss -> queue a scrape task) -------------------
HOMZ_ONDEMAND_ENABLED=true
HOMZ_ONDEMAND_MIN_RESULTS=5        # queue a fill when a search returns fewer
HOMZ_ONDEMAND_COOLDOWN_MINUTES=360 # don't re-queue the same query sooner
HOMZ_ONDEMAND_DAILY_BUDGET=500     # hard cap on tasks/day. Demand-driven
                                   # crawling is still crawling.
HOMZ_ONDEMAND_TASK_TTL_HOURS=24

# ---- ingest (client-side scraping posts results back) ----------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty disables /ingest/* entirely. NEVER leave this unset in production —
# an open ingest endpoint lets anyone write into your warehouse.
HOMZ_INGEST_TOKEN=
HOMZ_INGEST_MAX_PAYLOAD_BYTES=4000000
HOMZ_INGEST_RATE_LIMIT_PER_MINUTE=120

# ---- search api ------------------------------------------------------------
HOMZ_API_HOST=0.0.0.0
HOMZ_API_PORT=8000
HOMZ_API_PAGE_SIZE=25
HOMZ_API_MAX_PAGE_SIZE=100
# Browser origins allowed to call the API (the widget is cross-origin).
HOMZ_API_CORS_ORIGINS=https://www.homzrealtor.com,https://homzrealtor.com,http://localhost:8000
HOMZ_API_SERVE_WEB=true            # serve web/ from the API (dev convenience)
