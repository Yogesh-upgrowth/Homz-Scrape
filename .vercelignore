# Only `api/`, `data/feed/` and the build step scripts/split-feed.js need to ship to Vercel — everything else here
# is the Python scraper/exporter, which doesn't run on Vercel at all.
.venv/
venv/
node_modules/
__pycache__/
*.egg-info/
data/raw/
data/checkpoints/
*.html.gz
*.meta.json
tests/
docs/
web/
*.js
!api/*.js
!scripts/split-feed.js
