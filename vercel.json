{
  "version": 2,
  "framework": null,
  "buildCommand": "node scripts/split-feed.js",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/feed/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://www.homzrealtor.com" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS" },
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=604800, stale-while-revalidate=86400" }
      ]
    }
  ]
}
