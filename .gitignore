# --- secrets ---------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- node (legacy puppeteer scripts) ---------------------------------------
node_modules

# --- scraped data ----------------------------------------------------------
# The raw archive can reach tens of GB and is reproducible. Never commit it.
# `data/feed` is the exception: those are the deploy artifacts the Vercel
# serving function under `api/` reads directly, so they must be committed.
data/*
!data/.gitkeep
!data/feed/
*.html.gz
*.meta.json

# --- logs / local db -------------------------------------------------------
*.log
logs/
pgdata/

# --- editors / os ----------------------------------------------------------
.vscode/
.idea/
.DS_Store
*.swp
